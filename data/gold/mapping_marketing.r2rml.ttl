map:Receivable_arrearsAmt a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT RCVBL_ID, ROUND(RCVBL_AMT - RCVED_AMT, 2) AS ARREARS_AMT FROM yx186.A_RCVBL_FLOW" ] ;
  rr:subjectMap [ rr:template "http://sgcc.fj/data/Receivable/{RCVBL_ID}" ] ;
  rr:predicateObjectMap [ rr:predicate yx:Receivable_arrearsAmt ;
    rr:objectMap [ rr:column "ARREARS_AMT" ; rr:datatype xsd:decimal ] ] .

map:MeterReading_readEnergy a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT r.READ_ID, ROUND((r.THIS_READ - r.LAST_READ) * d.T_FACTOR, 2) AS READ_PQ FROM yx186.R_READ r JOIN yx186.C_METER_MP_RELA rl ON rl.MP_ID = r.MP_ID JOIN yx186.D_METER d ON d.METER_ID = rl.METER_ID" ] ;
  rr:subjectMap [ rr:template "http://sgcc.fj/data/MeterReading/{READ_ID}" ] ;
  rr:predicateObjectMap [ rr:predicate yx:MeterReading_readEnergy ;
    rr:objectMap [ rr:column "READ_PQ" ; rr:datatype xsd:decimal ] ] .
