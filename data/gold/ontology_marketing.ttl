@prefix yx: <http://sgcc.fj/ontology/marketing#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://sgcc.fj/ontology/marketing> a owl:Ontology ;
  rdfs:label "营销域本体（福州试点，PoC 真值）"@zh .

yx:SupplyOrg a owl:Class ; rdfs:label "供电单位"@zh ; skos:definition "电力企业内部的供电管理单位，含市公司、县公司、供电所"@zh .

yx:Consumer a owl:Class ; rdfs:label "用电客户"@zh ; skos:definition "与供电企业建立供用电关系的客户"@zh .

yx:Contact a owl:Class ; rdfs:label "客户联系人"@zh ; skos:definition "用电客户的联系人"@zh .

yx:MeteringPoint a owl:Class ; rdfs:label "计量点"@zh ; skos:definition "用于电能计量结算或考核的点"@zh .

yx:Meter a owl:Class ; rdfs:label "电能表"@zh ; skos:definition "电能表资产"@zh .

yx:MeterReading a owl:Class ; rdfs:label "抄表示数"@zh ; skos:definition "按月抄见的电能表示数"@zh .

yx:Receivable a owl:Class ; rdfs:label "应收电费"@zh ; skos:definition "按电费年月发行的应收电费"@zh .

yx:Payment a owl:Class ; rdfs:label "缴费记录"@zh ; skos:definition "客户缴纳电费的实收记录"@zh .

yx:Terminal a owl:Class ; rdfs:label "采集终端"@zh ; skos:definition "集中器、专变终端等采集设备"@zh .

yx:CollectionPoint a owl:Class ; rdfs:label "采集测量点"@zh ; skos:definition "采集终端下挂的测量点，对应营销计量点"@zh .

yx:DailyFrozenReading a owl:Class ; rdfs:label "日冻结示数"@zh ; skos:definition "采集终端每日零点冻结的电能示数"@zh .

yx:DailyEnergy a owl:Class ; rdfs:label "日电量"@zh ; skos:definition "按测量点计算的日电量"@zh .

yx:LoadCurvePoint a owl:Class ; rdfs:label "负荷曲线点"@zh ; skos:definition "测量点按时间采集的功率"@zh .

yx:WorkOrder a owl:Class ; rdfs:label "95598工单"@zh ; skos:definition "95598 受理的客户诉求工单"@zh .

yx:ReturnVisit a owl:Class ; rdfs:label "工单回访"@zh ; skos:definition "工单办结后的客户回访"@zh .

yx:SupplyOrg_orgNo a owl:DatatypeProperty ;
  rdfs:label "供电单位编码"@zh ;
  rdfs:domain yx:SupplyOrg ;
  rdfs:range xsd:string .

yx:SupplyOrg_orgName a owl:DatatypeProperty ;
  rdfs:label "供电单位名称"@zh ;
  skos:altLabel "供电单位"@zh ;
