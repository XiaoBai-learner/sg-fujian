yx:Receivable_arrearsAmt a owl:DatatypeProperty ;
  rdfs:label "欠费金额"@zh ;
  skos:altLabel "欠费"@zh ;
  skos:altLabel "欠费金额(元)"@zh ;
  rdfs:domain yx:Receivable ;
  rdfs:range xsd:decimal ;
  skos:note "派生属性：SELECT RCVBL_ID, ROUND(RCVBL_AMT - RCVED_AMT, 2) AS ARREARS_AMT FROM yx186.A_RCVBL_FLOW"@zh .

yx:MeterReading_readEnergy a owl:DatatypeProperty ;
  rdfs:label "抄见电量"@zh ;
  skos:altLabel "抄表电量"@zh ;
  rdfs:domain yx:MeterReading ;
  rdfs:range xsd:decimal ;
  skos:note "派生属性：SELECT r.READ_ID, ROUND((r.THIS_READ - r.LAST_READ) * d.T_FACTOR, 2) AS READ_PQ FROM yx186.R_READ r JOIN yx186.C_METER_MP_RELA rl ON rl.MP_ID = r.MP_ID JOIN yx186.D_METER d ON d.METER_ID = rl.METER_ID"@zh .
